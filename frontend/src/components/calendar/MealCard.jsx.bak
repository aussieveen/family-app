import { useState } from 'react'
import { getRecipe } from '../../api/cookbook'

export default function MealCard({ meal }) {
  const [recipe, setRecipe] = useState(null)
  const [open, setOpen] = useState(false)

  async function handleTap() {
    if (!recipe && meal.main?.recipeId) {
      const data = await getRecipe(meal.main.recipeId)
      setRecipe(data)
    }
    setOpen(true)
  }

  if (!meal.main) return null

  return (
    <>
      <button
        onClick={handleTap}
        className="border-t border-gray-200 p-1 flex items-center gap-2 w-full text-left hover:bg-amber-50"
      >
        {meal.main.image && (
          <img src={meal.main.image} alt={meal.main.name} className="w-10 h-10 rounded object-cover flex-shrink-0" />
        )}
        <span className="text-xs font-medium text-amber-900 truncate">{meal.main.name}</span>
      </button>

      {open && recipe && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50" onClick={() => setOpen(false)}>
          <div className="bg-white rounded-2xl shadow-2xl w-[90vw] max-h-[90vh] overflow-y-auto p-6" onClick={e => e.stopPropagation()}>
            <div className="flex justify-between items-start mb-4">
              <h2 className="text-2xl font-bold text-gray-900">{recipe.name}</h2>
              <button onClick={() => setOpen(false)} className="text-gray-400 hover:text-gray-600 text-2xl leading-none">×</button>
            </div>
            {recipe.image && <img src={recipe.image} alt={recipe.name} className="w-full max-h-64 object-cover rounded-xl mb-4" />}
            {recipe.components?.map((component, i) => (
              <div key={i} className="mb-4">
                {component.name && <h3 className="font-semibold text-gray-700 mb-1">{component.name}</h3>}
                <ul className="text-sm text-gray-600 space-y-0.5">
                  {component.ingredients?.map((ing, j) => (
                    <li key={j}>• {ing.revisedMeasurement ?? ing.measurement} {ing.ingredientName?.name}{ing.note ? ` (${ing.note})` : ''}</li>
                  ))}
                </ul>
              </div>
            ))}
            {recipe.steps?.map((step, i) => (
              <p key={i} className="text-sm text-gray-700 mb-2"><span className="font-semibold">{i + 1}.</span> {step.detail}</p>
            ))}
          </div>
        </div>
      )}
    </>
  )
}
